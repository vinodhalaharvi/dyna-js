{
  "name": "@vhalaharvi/react-eqsum",
  "version": "0.2.0",
  "description": "A React viewer that summarises a typeset PDF to N pages, keeping the equations: a slider for the length, the whole book a click away",
  "license": "MIT",
  "author": "Vinod Halaharvi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vinodhalaharvi/dyna-js.git",
    "directory": "packages/react-eqsum"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "prepublishOnly": "tsc -b"
  },
  "dependencies": {
    "@vhalaharvi/eqsum": "^0.2.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "pdfjs-dist": ">=5"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "react",
    "pdf",
    "summary",
    "equations",
    "latex",
    "math",
    "pdfjs"
  ],
  "homepage": "https://github.com/vinodhalaharvi/dyna-js/tree/main/packages/react-eqsum#readme",
  "bugs": {
    "url": "https://github.com/vinodhalaharvi/dyna-js/issues"
  }
}
