{
  "name": "@vhalaharvi/eqsum",
  "version": "0.3.0",
  "description": "Summaries of typeset books that keep the equations: an N-page summary chosen with dynamic programming, equations weighted most",
  "license": "MIT",
  "author": "Vinod Halaharvi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vinodhalaharvi/dyna-js.git",
    "directory": "packages/eqsum"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "prepublishOnly": "tsc -b"
  },
  "dependencies": {
    "@vhalaharvi/dyna": "^0.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "pdf",
    "summary",
    "equations",
    "latex",
    "math",
    "dynamic-programming",
    "knapsack"
  ],
  "homepage": "https://github.com/vinodhalaharvi/dyna-js/tree/main/packages/eqsum#readme",
  "bugs": {
    "url": "https://github.com/vinodhalaharvi/dyna-js/issues"
  }
}
